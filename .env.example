# Application
NODE_ENV=development
HOST=127.0.0.1
PORT=8081
REQUEST_BODY_LIMIT=1mb

# Docker Compose host ports and local service settings. These safe defaults can
# be changed when a port is already in use; restart the stack afterward.
LOCAL_API_PORT=8081
LOCAL_STORAGE_PORT=9000
LOCAL_MAILPIT_SMTP_PORT=1025
LOCAL_MAILPIT_UI_PORT=8025
LOCAL_MAILPIT_MAX_MESSAGES=1000
LOCAL_STORAGE_REGION=us-east-1
LOCAL_STORAGE_BUCKET=trackfusionweb-local
LOCAL_STORAGE_ACCESS_KEY_ID=trackfusion-local
LOCAL_STORAGE_SECRET_ACCESS_KEY=trackfusion-local-secret

# Browser access
# Production browser settings come from deploy/ec2/production-managed.env.
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
DEV_URLS=http://localhost:3000

# Authentication and cookies
# Generate each secret independently; use at least 32 random characters.
SESSION_SECRET=replace_with_a_long_random_value
JWT_SECRET=replace_with_a_different_long_random_value
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Production cookie settings also come from production-managed.env. Leave
# COOKIE_DOMAIN unset in every environment so API cookies remain host-only.
# COOKIE_DOMAIN=.example.com

# PostgreSQL
DATABASE_URL=postgresql://trackfusion:replace_me@localhost:5432/trackfusionweb_db
# Used by compose.yaml for its local PostgreSQL container.
POSTGRES_PASSWORD=replace_with_a_local_container_password

# Redis / Bull job queues
REDIS_URL=redis://127.0.0.1:6379

# Python audio processing
PYTHON_EXECUTABLE=venv/bin/python

# Object storage
# Advanced direct-node use. Docker Compose uses the LOCAL_STORAGE_* values
# above and overrides these endpoints with its internal/public addresses.
STORAGE_PROVIDER=s3-compatible
STORAGE_REGION=us-east-1
STORAGE_BUCKET=trackfusionweb-local
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:9000
STORAGE_ACCESS_KEY_ID=trackfusion-local
STORAGE_SECRET_ACCESS_KEY=trackfusion-local-secret
STORAGE_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Production AWS settings are intentionally omitted. This file is for local
# development and the local provider never contacts AWS.

# Transactional email
# Local SMTP is captured by the Compose Mailpit inbox at http://127.0.0.1:8025.
EMAIL_PROVIDER=smtp
EMAIL_DELIVERY_ENABLED=true
EMAIL_VALIDATE_MX=false
EXPOSE_OTP_IN_DEVELOPMENT=false
EXPOSE_RESET_TOKEN_IN_DEVELOPMENT=false
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
# Production deployment forces EMAIL_PROVIDER=resend and
# EMAIL_DELIVERY_ENABLED=true. Production RESEND_API_KEY is reconciled from the
# exact Parameter Store allowlist after an explicitly authorized cutover.
# Never commit a real API key.
# RESEND_API_KEY=replace_with_resend_api_key
# Optional comma-separated allowlist. Leave unset to allow any valid domain.
# EMAIL_ALLOWED_DOMAINS=example.com,example.org

# Audio upload settings
AUDIO_MAX_LENGTH=900
AUDIO_MAX_FILE_SIZE=300
ALLOWED_AUDIO_TYPES=audio/mp3,audio/wav,audio/wave,audio/mpeg,audio/ogg,audio/x-wav,audio/x-m4a,audio/aac

# Image upload settings
IMAGE_MAX_FILE_SIZE=50
ALLOWED_IMAGE_TYPES=image/jpeg,image/jpg,image/png,image/heic,image/heif
