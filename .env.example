# Application
NODE_ENV=development
HOST=127.0.0.1
PORT=8081
REQUEST_BODY_LIMIT=1mb

# Browser access
# Production browser settings come from deploy/ec2/production-managed.env.
FRONTEND_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3001
DEV_URLS=http://localhost:3001

# Authentication and cookies
# Generate each secret independently; use at least 32 random characters.
SESSION_SECRET=replace_with_a_long_random_value
JWT_SECRET=replace_with_a_different_long_random_value
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Production cookie settings also come from production-managed.env. Leave
# COOKIE_DOMAIN unset in every environment so API cookies remain host-only.
# COOKIE_DOMAIN=.example.com

# PostgreSQL
DATABASE_URL=postgresql://trackfusion:replace_me@localhost:5432/trackfusionweb_db
# Used by compose.yaml for its local PostgreSQL container.
POSTGRES_PASSWORD=replace_with_a_local_container_password

# Redis / Bull job queues
REDIS_URL=redis://127.0.0.1:6379

# Python audio processing
PYTHON_EXECUTABLE=venv/bin/python

# AWS S3
# Do not put AWS access keys in this file. For local development, set
# AWS_PROFILE to an AWS CLI profile. EC2 will use its attached IAM role.
AWS_REGION=us-east-1
AWS_PROFILE=trackfusion-local
AWS_S3_BUCKET=your-bucket-name
# Optional: only set this when configuration is stored in Secrets Manager.
# AWS_SECRETS_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:example

# Transactional email (Resend)
EMAIL_DELIVERY_ENABLED=false
EMAIL_VALIDATE_MX=false
EXPOSE_OTP_IN_DEVELOPMENT=true
EXPOSE_RESET_TOKEN_IN_DEVELOPMENT=true
# Required when EMAIL_DELIVERY_ENABLED=true. Never commit a real API key.
RESEND_API_KEY=replace_with_resend_api_key
# Optional comma-separated allowlist. Leave unset to allow any valid domain.
# EMAIL_ALLOWED_DOMAINS=example.com,example.org

# Audio upload settings
AUDIO_MAX_LENGTH=900
AUDIO_MAX_FILE_SIZE=300
ALLOWED_AUDIO_TYPES=audio/mp3,audio/wav,audio/wave,audio/mpeg,audio/ogg,audio/x-wav,audio/x-m4a,audio/aac

# Image upload settings
IMAGE_MAX_FILE_SIZE=50
ALLOWED_IMAGE_TYPES=image/jpeg,image/jpg,image/png,image/heic,image/heif
